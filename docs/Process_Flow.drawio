  <diagram name="§3.2 스트로크 실패" id="pfd-p4"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="820" dx="820" dy="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p_p4_A" value="궤적 실행&lt;br/&gt;&lt;b&gt;F4.3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="200" height="60" as="geometry" /></mxCell><mxCell id="p_p4_B" value="스트로크 성공?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="305" y="170" width="190" height="90" as="geometry" /></mxCell><mxCell id="p_p4_NEXT" value="다음 스트로크&lt;br/&gt;→ 본 흐름 복귀" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="360" width="220" height="60" as="geometry" /></mxCell><mxCell id="p_p4_E" value="&lt;b&gt;실패 스트로크 기록 후 계속&lt;/b&gt;&lt;br/&gt;&lt;b&gt;F4.4&lt;/b&gt; · &lt;b&gt;F6.3&lt;/b&gt; 이력 저장&lt;br/&gt;&lt;i&gt;Phase 1 — 재시도 없음&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="430" y="350" width="320" height="100" as="geometry" /></mxCell><mxCell id="p_p4_RETRY" value="재시도 경로&lt;br/&gt;&lt;i&gt;Phase 1 미사용 — 구현 파라미터로 보류&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="560" width="300" height="80" as="geometry" /></mxCell><mxCell id="p_p4_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p_p4_A" target="p_p4_B"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_p4_e2" value="성공" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p_p4_B" target="p_p4_NEXT"><mxGeometry relative="1" as="geome