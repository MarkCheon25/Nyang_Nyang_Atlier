  <diagram name="§4.1 캘리브레이션 준비" id="pfd-p7"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="920" dx="1120" dy="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p7_prep" value="준비 흐름 — 1회 (장비·지그 재배치 시에만)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="520" height="780" as="geometry" /></mxCell><mxCell id="p7_H1" value="👤 기준마커(ChArUco) 배치" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p7_prep"><mxGeometry x="140" y="40" width="240" height="60" as="geometry" /></mxCell><mxCell id="p7_K1" value="카메라 ↔ 로봇 좌표계&lt;br/&gt;캘리브레이션&lt;br/&gt;&lt;b&gt;F5.1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p7_prep"><mxGeometry x="140" y="150" width="240" height="70" as="geometry" /></mxCell><mxCell id="p7_K2" value="오차 허용범위 내?&lt;br/&gt;(R5)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="p7_prep"><mxGeometry x="150" y="270" width="220" height="110" as="geometry" /></mxCell><mxCell id="p7_H2" value="👤 A4 지그(고정 틀) 설치&lt;br/&gt;+ 종이 1장 배치" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p7_prep"><mxGeometry x="140" y="420" width="240" height="70" as="geometry" /></mxCell><mxCell id="p7_K4" value="지그 기준 A4 종이&lt;br/&gt;위치·자세 인식&lt;br/&gt;&lt;b&gt;F5.2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p7_prep"><mxGeometry x="140" y="530" width="240" height="70" as="geometry" /></mxCell><mxCell id="p7_K3" value="&lt;b&gt;F5.3&lt;/b&gt; 저장&lt;br/&gt;① 카메라↔로봇 변환행렬&lt;br/&gt;② 지그 기준 종이 자세" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e8f0fe;strokeColor=#4285f4;" vertex="1" parent="p7_prep"><mxGeometry x="130" y="640" width="260" height="110" as="geometry" /></mxCell><mxCell id="p7_main" value="본 흐름 — 작업 1장마다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="420" height="380" as="geometry" /></mxCell><mxCell id="p7_M0" value="👤 지그에 A4 종이 배치&lt;br/&gt;&lt;i&gt;Phase 1 — 사람이 놓는다&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#fbbc04;" vertex="1" parent="p7_main"><mxGeometry x="50" y="50" width="320" height="70" as="geometry" /></mxCell><mxCell id="p7_M2" value="종이 좌표 → 로봇 좌표 변환&lt;br/&gt;&lt;b&gt;F4.1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p7_main"><mxGeometry x="50" y="170" width="320" height="70" as="geometry" /></mxCell><mxCell id="p7_M3" value="MoveIt2 궤적 계획&lt;br/&gt;&lt;b&gt;F4.2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p7_main"><mxGeometry x="50" y="290" width="320" height="60" as="geometry" /></mxCell><mxCell id="p7_e_H1_K1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p7_H1" target="p7_K1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e_K1_K2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p7_K1" target="p7_K2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e_K2_K1" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p7_K2" target="p7_K1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7_e_K2_H2" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p7_K2" target="p7_H2"><mxGeometry relative="1" as="geometry" /></mxCell