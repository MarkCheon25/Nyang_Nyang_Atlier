  <diagram name="§3.3 긴급정지" id="pfd-p5"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="920" dx="1000" dy="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p5_ANY" value="본 흐름의 &lt;b&gt;모든&lt;/b&gt; 단계 — 예외 없음" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#000000;verticalAlign=top;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="120" y="40" width="760" height="130" as="geometry" /></mxCell><mxCell id="p5_S1" value="F1&lt;br/&gt;입력" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p5_ANY"><mxGeometry x="20" y="50" width="140" height="60" as="geometry" /></mxCell><mxCell id="p5_S2" value="F2&lt;br/&gt;이미지 분석" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p5_ANY"><mxGeometry x="200" y="50" width="140" height="60" as="geometry" /></mxCell><mxCell id="p5_S3" value="F3&lt;br/&gt;계획 수립" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p5_ANY"><mxGeometry x="380" y="50" width="140" height="60" as="geometry" /></mxCell><mxCell id="p5_S4" value="F4&lt;br/&gt;드로잉 실행" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p5_ANY"><mxGeometry x="560" y="50" width="140" height="60" as="geometry" /></mxCell><mxCell id="p5_TRIG" value="긴급정지 발동&lt;br/&gt;&lt;b&gt;Phase 1 = 운영 UI 버튼&lt;/b&gt;&lt;br/&gt;&lt;i&gt;물리 E-stop·안전센서는 Phase 3&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="320" height="100" as="geometry" /></mxCell><mxCell id="p5_STOP" value="&lt;b&gt;즉시 로봇 정지&lt;/b&gt;&lt;br/&gt;&lt;b&gt;F6.4&lt;/b&gt; · &lt;b&gt;N4&lt;/b&gt; 즉시 반영" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#