  <diagram name="§3.4 일시정지" id="pfd-p6"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1020" dx="1000" dy="1020" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p6_ANY2" value="본 흐름의 &lt;b&gt;모든&lt;/b&gt; 단계" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#000000;verticalAlign=top;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="130" y="40" width="740" height="140" as="geometry" /></mxCell><mxCell id="p6_T1" value="F1&lt;br/&gt;입력" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p6_ANY2"><mxGeometry x="20" y="60" width="150" height="60" as="geometry" /></mxCell><mxCell id="p6_T2" value="F2&lt;br/&gt;이미지 분석" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p6_ANY2"><mxGeometry x="200" y="60" width="150" height="60" as="geometry" /></mxCell><mxCell id="p6_T3" value="F3&lt;br/&gt;계획 수립" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p6_ANY2"><mxGeometry x="380" y="60" width="150" height="60" as="geometry" /></mxCell><mxCell id="p6_T4" value="F4&lt;br/&gt;드로잉 실행" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p6_ANY2"><mxGeometry x="560" y="60" width="150" height="60" as="geometry" /></mxCell><mxCell id="p6_PTRIG" value="일시정지 발동&lt;br/&gt;&lt;b&gt;F6.5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#fbbc04;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="410" y="250" width="180" height="70" as="geometry" /></mxCell><mxCell id="p6_PENUP" value="펜 들어올림 (pen-up)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="200" height="60" as="geometry" /></mxCell><mxCell id="p6_