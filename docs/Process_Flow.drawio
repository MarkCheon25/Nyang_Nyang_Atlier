  <diagram name="§1 전체 지도" id="pfd-p1"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="520" dx="1200" dy="520" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p_p1_PREP" value="&lt;b&gt;A. 준비 흐름&lt;/b&gt;&lt;br/&gt;F5.1 · F5.2 · F5.3&lt;br/&gt;&lt;i&gt;1회 — 장비·지그 재배치 시에만&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="280" height="120" as="geometry" /></mxCell><mxCell id="p_p1_ESTOP" value="&lt;b&gt;C. 긴급정지&lt;/b&gt;&lt;br/&gt;F6.4 — &lt;b&gt;상태 폐기&lt;/b&gt;&lt;br/&gt;&lt;i&gt;어떤 단계에서든&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="280" height="120" as="geometry" /></mxCell><mxCell id="p_p1_PAUSE" value="&lt;b&gt;D. 일시정지&lt;/b&gt;&lt;br/&gt;F6.5 — &lt;b&gt;상태 보존·재개&lt;/b&gt;&lt;br/&gt;&lt;i&gt;어떤 단계에서든&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#fbbc04;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="280" height="120" as="geometry" /></mxCell><mxCell id="p_p1_MAIN" value="&lt;b&gt;B. 본 흐름 (E2E)&lt;/b&gt;&lt;br/&gt;F1 → F2 → F3 → F4&lt;br/&gt;&lt;i&gt;작업 1장마다&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="280" height="120" as="geometry" /></mxCell><mxCell id="p_p1_e_PREP_MAIN" value="저장된 변환행렬 + 종이 자세 소비&lt;br/&gt;(F5.3 → F4.1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p_p1_PREP" target="p_p1_MAIN"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_p1_e_ESTOP_MAIN" value="모든 단계에서 진입" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="p_p1_ESTOP" target="p_p1_MAIN"><mxGeometry relative="1" as="geometry" 