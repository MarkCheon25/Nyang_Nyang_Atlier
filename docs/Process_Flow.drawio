  <diagram name="§5 시뮬 3단계 분기" id="pfd-p8"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="920" dx="1120" dy="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p8_COMMON" value="&lt;b&gt;F1 → F2 → F3 → F4.1 → F4.2&lt;/b&gt;&lt;br/&gt;세 환경 완전 동일&lt;br/&gt;&lt;i&gt;순수 계산 + MoveIt2 계획 — 하드웨어 무관&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="360" height="80" as="geometry" /></mxCell><mxCell id="p8_BOUNDARY" value="&lt;b&gt;하드웨어 추상화 경계&lt;/b&gt;&lt;br/&gt;&lt;b&gt;N6&lt;/b&gt; · &lt;b&gt;F7.3&lt;/b&gt;&lt;br/&gt;동일 제어 코드가 여기까지" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#856404;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="360" height="120" as="geometry" /></mxCell><mxCell id="p8_MJ" value="&lt;b&gt;MuJoCo&lt;/b&gt;&lt;br/&gt;궤적 → 물리엔진&lt;br/&gt;캘리브레이션 = ground truth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="280" height="100" as="geometry" /></mxCell><mxCell id="p8_ISAAC" value="&lt;b&gt;IsaacSim (선택)&lt;/b&gt;&lt;br/&gt;궤적 → 물리엔진&lt;br/&gt;RealSense 센서 시뮬&lt;br/&gt;&lt;i&gt;별도 PC&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="280" height="100" as="geometry" /></mxCell><mxCell id="p8_REAL" value="&lt;b&gt;HCR-5 실물&lt;/b&gt;&lt;br/&gt;궤적 → 컨트롤러&lt;br/&gt;&lt;i&gt;랩 방문일에만 (C1)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="280" height="100" as="geometry" /></mxCell><mxCell id="p8_R1BLOCK" value="🚫 &lt;b&gt;R1 — 크리티컬 패스&lt;/b&gt;&lt;br/&gt;개발 PC → HCR-5 스크립트 제어 &lt;b&gt;미성공&lt;/b&gt;&lt;br/&gt;(펜던트 제어는 성공)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="770" y="600" width="300" height="120" as="geometry" /></mxCell><mxCell id="p8_OK1" value="✅ 흐름 완주 가능" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="240" height="70" as="geometry" /></mxCell><mxCell id="p8_OK2" value="✅ 흐름 완주 가능" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="620" width="240" height="70" as="geometry" /></mxCell><mxCell id="p8_BLOCKED" value="⛔ &lt;b&gt;F4.3 실물 실행 대기&lt;/b&gt;&lt;br/&gt;→ 실물 First Stroke 대기" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="780" y="790" width="280" height="90" as="geometry" /></mxCell><mxCell id="p8_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_COMMON" target="p8_BOUNDARY"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8_e2" value="F7.1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_BOUNDARY" target="p8_MJ"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8_e3" value="F7.2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_BOUNDARY" target="p8_ISAAC"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8_e4" value="실물" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_BOUNDARY" target="p8_REAL"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_REAL" target="p8_R1BLOCK"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_MJ" target="p8_OK1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_ISAAC" target="p8_OK2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p8_R1BLOCK" target="p8_BLOCKED"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
