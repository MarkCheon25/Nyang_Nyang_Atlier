# ── colcon / ROS 2 워크스페이스 빌드 산출물 ──
build/
install/
log/

# ── 워크스페이스에 소스로 받는 외부 패키지 ──
# apt로 배포되지 않아 git clone 으로 가져오는 것들 (중첩 리포가 되므로 제외)
src/moveit2/ws_moveit2/src/moveit2_tutorials/

# ── Claude Code PC 로컬 설정 ──
# 멀티PC 공유 계약상 동기화 대상 아님 (PC 로컬 자산)
.claude/settings.local.json

# ── PC 로컬 GPU 오버라이드 ──
# compose.yml 기본값은 AMD/Intel(A). NVIDIA PC 등 다른 GPU 설정은
# PC별로 여기에 compose.override.yml 을 만들어 쓴다 (커밋 대상 아님)
src/moveit2/compose.override.yml

# ── vision 입출력 데이터 ──
# 입력 샘플 이미지와 CLI 산출물(SVG·PNG·CSV)은 런타임 자산이라 커밋하지 않는다
src/vision/data/

# ── operator 런타임 데이터 ──
# CLI 하네스 산출물(job.json·timeline.*)과, 나중에 웹이 쓸 uploads/·results/·atlier.db.
# operator 에는 compose.override.yml 훅이 없다 — 창을 띄우지 않아 GPU 설정이 필요 없다
src/operator/data/

# ── Python ──
__pycache__/
*.py[cod]

# ── 에디터 · OS ──
.vscode/
.idea/
*.swp
.DS_Store
