# ── colcon / ROS 2 워크스페이스 빌드 산출물 ──
build/
install/
log/

# ── 워크스페이스에 소스로 받는 외부 패키지 ──
# apt로 배포되지 않아 git clone 으로 가져오는 것들 (중첩 리포가 되므로 제외)
src/moveit2/ws_moveit2/src/moveit2_tutorials/

# ── Claude Code PC 로컬 설정 ──
# 멀티PC 공유 계약상 동기화 대상 아님 (PC 로컬 자산)
.claude/settings.local.json

# ── PC 로컬 GPU 오버라이드 ──
# compose.yml 기본값은 AMD/Intel(A). NVIDIA PC 등 다른 GPU 설정은
# PC별로 여기에 compose.override.yml 을 만들어 쓴다 (커밋 대상 아님)
src/moveit2/compose.override.yml

# ── 캘리브레이션 런타임 산출물 ──
# cal.py 가 인쇄물 PDF · 결과 YAML(distortion/reference/homography/paper) · 원자료를
# 여기 떨군다. 전부 재생성되는 것이라 커밋하지 않는다.
# 경로는 cal_config.py 의 paths.data_dir — 환경변수 CAL_DATA_DIR 로 덮을 수 있다.
src/drivers/cam_comm/calibration/data/

# ── Python ──
__pycache__/
*.py[cod]

# ── 에디터 · OS ──
.vscode/
.idea/
*.swp
.DS_Store
