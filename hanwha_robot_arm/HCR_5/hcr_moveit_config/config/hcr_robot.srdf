<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="hcr_robot">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <group name="hcr_arm">
        <joint name="joint_1"/>
        <joint name="joint_2"/>
        <joint name="joint_3"/>
        <joint name="joint_4"/>
        <joint name="joint_5"/>
        <joint name="joint_6"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <!-- 2026-08-05 실기 홈으로 교체.
         종전 값 (0, 0, 1.5669, -1.59, -1.4695, 0) 은 실기 홈에서 715mm 떨어진 자세였다 —
         근거 없이 들어간 값으로 보인다.
         실기 홈 = [0, -90, -90, -90, 90, 0] 도 (Mark 확인)
           → URDF 규약 변환 q_URDF = s*q_실기 + δ, s=(1,1,-1,1,1,1), δ=(90,90,0,90,0,0)
           → [90, 0, 90, 0, 90, 0] 도 = 아래 라디안 값
         이 자세에서 flange = (490.0, -170.5, 441.5) mm, rx=-180 (플랜지가 정확히 아래).
         펜을 아래로 향한 자세라 소묘 기준자세로 그대로 쓸 수 있다. 근거: 업무목록 T16 -->
    <group_state name="hcr_home" group="hcr_arm">
        <joint name="joint_1" value="1.570796"/>
        <joint name="joint_2" value="0"/>
        <joint name="joint_3" value="1.570796"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="1.570796"/>
        <joint name="joint_6" value="0"/>
    </group_state>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="link1_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link2_1" reason="Never"/>
    <disable_collisions link1="link1_1" link2="link2_1" reason="Adjacent"/>
    <disable_collisions link1="link1_1" link2="link3_1" reason="Never"/>
    <disable_collisions link1="link1_1" link2="link4_1" reason="Never"/>
    <disable_collisions link1="link1_1" link2="link5_1" reason="Never"/>
    <disable_collisions link1="link1_1" link2="link6_1" reason="Never"/>
    <disable_collisions link1="link2_1" link2="link3_1" reason="Adjacent"/>
    <disable_collisions link1="link2_1" link2="link4_1" reason="Never"/>
    <disable_collisions link1="link2_1" link2="link5_1" reason="Never"/>
    <disable_collisions link1="link3_1" link2="link4_1" reason="Adjacent"/>
    <disable_collisions link1="link3_1" link2="link5_1" reason="Never"/>
    <disable_collisions link1="link3_1" link2="link6_1" reason="Never"/>
    <disable_collisions link1="link4_1" link2="link5_1" reason="Adjacent"/>
    <disable_collisions link1="link4_1" link2="link6_1" reason="Never"/>
    <disable_collisions link1="link5_1" link2="link6_1" reason="Adjacent"/>
    <!-- ── 2026-08-12 P1: 펜홀더 nyang_pen ────────────────────────────────────
         ⚠️ 이 3줄이 없으면 **로봇이 아무 계획도 못 세운다.** 실측으로 확인했다:
           · link6_1 ↔ nyang_pen_holder 가 7.5mm 침투한 채 상시 충돌
           · 계획 요청이 `CheckStartStateCollision` 어댑터에서 전부 중단
             ("1 contact(s) detected : link6_1 - nyang_pen_holder") → error_code 99999
           · joint goal · pose goal 양쪽 다 막힌다
         (P1 지시서 §4-C3 은 SRDF 를 "선택 — 넣지 않아도 P2 가 막히지 않는다"로
          적었지만 사실과 다르다. 필수다.)

         왜 disable 이 옳은가 — 아래 셋은 전부 **fixed joint 로 강체 결합**이라
         서로의 상대 자세가 절대 변하지 않는다. 검사해 봐야 결과가 상수다.
         기존 본체 Adjacent 쌍 16건과 같은 취급이다.

         7.5mm 침투 자체는 기구학이 아니라 **mesh 탓**이다 — T16 이 joint_6 을
         42.9mm 옮겼는데 link6_1.stl 은 CAD 기준 그대로라 플랜지 형상이 공구
         방향으로 그만큼 더 나와 있다 (hcr_robot.xacro:192). mesh 교체는 별도 과제.

         ★ 펜과 **본체 다른 링크**(link1_1~link5_1·base_link)의 충돌은 그대로
           살려 둔다 — 소묘는 펜이 종이·책상에 닿는 작업이라 그쪽이 진짜 검사다 -->
    <disable_collisions link1="link6_1"          link2="nyang_pen_holder" reason="Adjacent"/>
    <disable_collisions link1="link6_1"          link2="nyang_pen_body"   reason="Adjacent"/>
    <disable_collisions link1="nyang_pen_holder" link2="nyang_pen_body"   reason="Adjacent"/>
</robot>
