<!-- ═══ 2026-08-05 실측 교정 ═══════════════════════════════════════════════════
  실기(Rodi 1.003.005)의 FK RPC robot/convertPose 로 6축을 20°씩 전 회전 스윕(108샘플,
  원적합 RMS 0.000mm)해 기구학을 추출하고 이 URDF 와 대조했다. 결과:

  · origin 이 실기와 달랐다 (아래 ★ 표시 8곳). 특히 joint_6.x 의 42.9mm 오차가 지배적으로,
    그것만 고쳐도 RMS 43.4mm → 1.6mm 로 떨어진다. 나머지는 1mm 이하의 미세 보정이다.
    전부 적용 후 전 자세 위치오차 **RMS 43.4mm → 0.0060mm** (최대 0.0130mm, 109샘플 검증).
  · limit 은 CAD 더미값(velocity=100 rad/s = 5729°/s)이었다. 매뉴얼 공식값으로 교체.
  · 실기와 URDF 는 **영점 규약이 다르다**. 브릿지는 반드시 아래 변환을 적용할 것:
        q_URDF[i] = s[i]*q_실기[i] + δ[i]      (도)
        s = (+1, +1, −1, +1, +1, +1)          ← J3 만 부호 반전
        δ = ( 90,  90,   0,  90,   0,   0)
    실기 zero = 팔이 수평으로 뻗은 자세, URDF zero = 팔이 수직으로 선 자세.
    실기 홈 [0,−90,−90,−90,90,0] = URDF [90,0,90,0,90,0] (SRDF hcr_home 과 일치시킴)
  · mesh 는 CAD 기준 그대로다 — joint_6 을 42.9mm 옮겼으므로 시각화가 그만큼 어긋난다.
    실기 제어에는 기구학 일치가 우선이라 이쪽을 택했다. mesh 교체는 별도 과제.
  근거·재현: 업무목록 T16 · src/drivers/hcr5_mqtt/README.md
════════════════════════════════════════════════════════════════════════════ -->

<joint name="joint_1" type="revolute">
  <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link1_1"/>
  <axis xyz="0.0 -0.0 1.0"/>
  <!-- 공식 ±360°, 180°/s (Appendix F·G). 종전 0~360°(음수 불가)는 IK 해가 있어도 계획 실패를 낳았다 -->
  <!-- ★ 2026-08-15 교정 — 한계를 **실기 ±360° 에 정합**시켰다. 종전 URDF 대칭 ±360° 는
       δ=90° 탓에 실기로는 [+270°, −450°] 라, 양(+)방향으로 **한 바퀴를 못 돌았다.**
       실측: 실기 267.77° 에서 발행이 끊겼다 (URDF 360° = 실기 270° 벽).
         upper  7.853981 ≈ URDF +450° = 실기 +360°
         lower −4.712388 ≈ URDF −270° = 실기 −360°
       ⚠️ 끝자리를 **안쪽으로 내렸다.** 정확한 450° 는 7.853981633974483 인데, 반올림한
          `7.853982` 를 쓰면 실기 환산이 **360.000021°** 라 `withinLimits()`(실기 ±360°)에 걸린다 —
          URDF 한계는 통과하는데 실기 검사가 막는 **게이트 충돌**이다. `-4.712389` 도 같다(−360.0000011°).
          실측 2026-08-15: 목표 360° 가 이 경계에서 차단돼 **359.98° 에 멈췄다.**
          URDF 한계는 실기 한계보다 **항상 안쪽**이어야 두 검사가 싸우지 않는다.
       δ=90° 인 j1·j2·j4 가 같은 결함이었다. 근거: hcr5_bridge/운전절차.md §5 함정 ⑨ -->
  <limit upper="7.853981" lower="-4.712388" effort="100" velocity="3.141593"/>
</joint>

<joint name="joint_2" type="revolute">
  <!-- ★ 실측 교정: x −0.0785→−0.059138 (+19.36mm). joint_3.x 와 짝을 이룬다 (아래 참조) -->
  <origin xyz="-0.059138 0.0 0.119001" rpy="0 0 0"/>
  <parent link="link1_1"/>
  <child link="link2_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <!-- ★ 2026-08-15 교정 — δ=90° 정합. joint_1 주석 참조 -->
  <limit upper="7.853981" lower="-4.712388" effort="100" velocity="3.141593"/>
</joint>

<joint name="joint_3" type="revolute">
  <!-- ★ 실측 교정: z 0.424→0.425001 (상완 +1mm) · y 0.001→0 · x 0.000652→−0.019348
       joint_2.x 와 joint_3.x 는 축이 평행해 겉보기엔 합만 의미 있을 것 같지만, 두 origin
       사이에 J2 회전이 끼어 있어 실제로는 개별 식별된다. 합만 맞추면 RMS 가 0.28mm 로
       남고, 최소제곱 해를 그대로 쓰면 0.0038mm 가 된다 -->
  <origin xyz="-0.019348 0.0 0.425001" rpy="0 0 0"/>
  <parent link="link2_1"/>
  <child link="link3_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <!-- J3 만 별도 제한 ±165° 가 실제로 존재한다 -->
  <limit upper="2.879793" lower="-2.879793" effort="100" velocity="3.141593"/>
</joint>

<joint name="joint_4" type="revolute">
  <!-- ★ 실측 교정: z 0.338567→0.338499 (−0.07mm) -->
  <origin xyz="-0.030016 -8e-06 0.338499" rpy="0 0 0"/>
  <parent link="link3_1"/>
  <child link="link4_1"/>
  <axis xyz="-1.0 0.0 -0.0"/>
  <!-- ★ 2026-08-15 교정 — δ=90° 정합. joint_1 주석 참조 -->
  <limit upper="7.853981" lower="-4.712388" effort="100" velocity="3.141593"/>
</joint>

<joint name="joint_5" type="revolute">
  <!-- ★ 실측 교정: z 0.089596→0.089504 (−0.09mm) -->
  <origin xyz="-0.062 0.0 0.089504" rpy="0 0 0"/>
  <parent link="link4_1"/>
  <child link="link5_1"/>
  <axis xyz="-0.0 -0.0 1.0"/>
  <!-- 실기 wrist2 가 −267° 로 관측된다 — 종전 ±120° 로는 현재 자세조차 표현 못 했다 -->
  <limit upper="6.283185" lower="-6.283185" effort="100" velocity="3.141593"/>
</joint>

<joint name="joint_6" type="revolute">
  <!-- ★ 실측 교정: x −0.089596→−0.132498 (−42.90mm). J5 축에서 flange 까지 거리가
       실기 132.5mm 인데 URDF 는 89.6mm 였다. 이 한 건이 전체 오차의 대부분이었다 -->
  <origin xyz="-0.132498 0.0 0.062" rpy="0 0 0"/>
  <parent link="link5_1"/>
  <child link="link6_1"/>
  <axis xyz="-1.0 -0.0 0.0"/>
  <limit upper="6.283185" lower="-6.283185" effort="100" velocity="3.141593"/>
</joint>

<!-- ── 공구: 펜홀더 nyang_pen ─────────────────────────────────────────────────
  플랜지(link6_1) 아래로 tool0 → 홀더 → 펜 → pen_tip 을 잇는다. pose goal 은
  pen_tip 을 겨눈다 — 이 include 가 없으면 IK 가 **플랜지 기준**으로 풀린다.

  본체와 분리된 패키지인 이유 · 명목 치수 · 강성 가정 · 축 방향 근거는 전부
  src/drivers/nyang_pen/urdf/nyang_pen.xacro 머리말에 있다. 여기 옮겨 적지 않는다.
  치수를 바꿀 때도 그 파일의 매크로 기본값만 고친다 (P1 판정 — 인자 관통 안 함).

  ⚠️ 이 패키지는 compose.yml 이 src/drivers/ 를 마운트해야 컨테이너에서 보인다 -->
<xacro:include filename="$(find nyang_pen)/urdf/nyang_pen.xacro"/>
<xacro:nyang_pen parent="link6_1"/>

</robot>
