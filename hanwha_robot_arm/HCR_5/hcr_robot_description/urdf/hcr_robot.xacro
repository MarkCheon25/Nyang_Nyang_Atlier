  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://hcr_robot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
