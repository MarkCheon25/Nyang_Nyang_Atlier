<?xml version="1.0" ?>
<robot name="hcr_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ── 인자 (하드웨어 추상화 경계) ────────────────────────────────────────────
  선언을 **이 파일에** 두는 이유 — 이 URDF 를 읽는 진입점이 둘이다.
    · hcr_robot_description/launch/display.launch.py  → 이 파일을 직접 읽는다
    · hcr_moveit_config/config/hcr_robot.urdf.xacro   → 이 파일을 include 한다
  기본값을 여기 두어야 두 경로가 다 산다. moveit 쪽에서 넘기는 mappings 가 이 기본값을 덮는다.

    xacro hcr_robot.xacro                                          # mock (기본)
    xacro hcr_robot.xacro hardware_plugin:=hcr5_bridge/HcrSystemInterface \
                          rw_rate:=30 is_async:=true               # 실기 읽기
    xacro hcr_robot.xacro hardware_plugin:=hcr5_bridge/HcrSystemInterface \
                          rw_rate:=30 is_async:=true \
                          allow_motion:=true                       # 실기 쓰기 ⚠️ 움직인다
  값의 의미·근거는 hcr_robot.ros2_control.xacro 머리말 -->
<xacro:arg name="hardware_plugin" default="mock_components/GenericSystem"/>
<xacro:arg name="rw_rate"         default="100"/>
<xacro:arg name="is_async"        default="false"/>
<!-- 기본값 false 는 플러그인 기본값과 같다 — 인자를 잊어도 로봇은 안 움직인다 -->
<xacro:arg name="allow_motion"    default="false"/>

<xacro:include filename="$(find hcr_robot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find hcr_robot_description)/urdf/hcr_robot.trans" />
<xacro:include filename="$(find hcr_robot_description)/urdf/hcr_robot.gazebo" />
<xacro:include filename="$(find hcr_robot_description)/urdf/hcr_robot.ros2_control.xacro" />
<xacro:hcr_robot_ros2_control plugin="$(arg hardware_plugin)"
                              rw_rate="$(arg rw_rate)"
                              is_async="$(arg is_async)"
                              allow_motion="$(arg allow_motion)"/>
