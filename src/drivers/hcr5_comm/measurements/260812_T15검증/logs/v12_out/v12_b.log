al>\n    <visual>\n      <origin rpy="0 0 0" xyz="0.107864 -0.000992 -0.911345"/>\n      <geometry>\n        <mesh filename="package://hcr_robot_description/meshes/link4_1.stl" scale="0.001 0.001 0.001"/>\n      </geometry>\n      <material name="silver"/>\n    </visual>\n    <collision>\n      <origin rpy="0 0 0" xyz="0.107864 -0.000992 -0.911345"/>\n      <geometry>\n        <mesh filename="package://hcr_robot_description/meshes/link4_1.stl" scale="0.001 0.001 0.001"/>\n      </geometry>\n    </collision>\n  </link>\n  <link name="link5_1">\n    <inertial>\n      <origin rpy="0 0 0" xyz="-0.022082116809040042 -5.860596366637823e-07 0.0534553107989999"/>\n      <mass value="6.518501237017786"/>\n      <inertia ixx="0.007541" ixy="0.0" ixz="0.001224" iyy="0.012794" iyz="-0.0" izz="0.010966"/>\n    </inertial>\n    <visual>\n      <origin rpy="0 0 0" xyz="0.169864 -0.000992 -1.000941"/>\n      <geometry>\n        <mesh filename="package://hcr_robot_description/meshes/link5_1.stl" scale="0.001 0.001 0.001"/>\n      </geometry>\n      <material name="silver"/>\n    </visual>\n    <collision>\n      <origin rpy="0 0 0" xyz="0.169864 -0.000992 -1.000941"/>\n      <geometry>\n        <mesh filename="package://hcr_robot_description/meshes/link5_1.stl" scale="0.001 0.001 0.001"/>\n      </geometry>\n    </collision>\n  </link>\n  <link name="link6_1">\n    <inertial>\n      <origin rpy="0 0 0" xyz="-0.019264152679962065 -4.5474100852818493e-07 -0.0005907014657897669"/>\n      <mass value="1.6914762668461325"/>\n      <inertia ixx="0.001473" ixy="0.0" ixz="-8e-06" iyy="0.00094" iyz="0.0" izz="0.000976"/>\n    </inertial>\n    <visual>\n      <origin rpy="0 0 0" xyz="0.25946 -0.000992 -1.062941"/>\n      <geometry>\n        <mesh filename="package://hcr_robot_description/meshes/link6_1.stl" scale="0.001 0.001 0.001"/>\n      </geometry>\n      <material name="silver"/>\n    </visual>\n    <collision>\n      <origin rpy="0 0 0" xyz="0.25946 -0.000992 -1.062941"/>\n      <geometry>\n        <mesh filename="package://hcr_robot_description/meshes/link6_1.stl" scale="0.001 0.001 0.001"/>\n      </geometry>\n    </collision>\n  </link>\n  <!-- ═══ 2026-08-05 실측 교정 ═══════════════════════════════════════════════════\n  실기(Rodi 1.003.005)의 FK RPC robot/convertPose 로 6축을 20°씩 전 회전 스윕(108샘플,\n  원적합 RMS 0.000mm)해 기구학을 추출하고 이 URDF 와 대조했다. 결과:\n\n  · origin 이 실기와 달랐다 (아래 ★ 표시 8곳). 특히 joint_6.x 의 42.9mm 오차가 지배적으로,\n    그것만 고쳐도 RMS 43.4mm → 1.6mm 로 떨어진다. 나머지는 1mm 이하의 미세 보정이다.\n    전부 적용 후 전 자세 위치오차 **RMS 43.4mm → 0.0060mm** (최대 0.0130mm, 109샘플 검증).\n  · limit 은 CAD 더미값(velocity=100 rad/s = 5729°/s)이었다. 매뉴얼 공식값으로 교체.\n  · 실기와 URDF 는 **영점 규약이 다르다**. 브릿지는 반드시 아래 변환을 적용할 것:\n        q_URDF[i] = s[i]*q_실기[i] + δ[i]      (도)\n        s = (+1, +1, −1, +1, +1, +1)          ← J3 만 부호 반전\n        δ = ( 90,  90,   0,  90,   0,   0)\n    실기 zero = 팔이 수평으로 뻗은 자세, URDF zero = 팔이 수직으로 선 자세.\n    실기 홈 [0,−90,−90,−90,90,0] = URDF [90,0,90,0,90,0] (SRDF hcr_home 과 일치시킴)\n  · mesh 는 CAD 기준 그대로다 — joint_6 을 42.9mm 옮겼으므로 시각화가 그만큼 어긋난다.\n    실기 제어에는 기구학 일치가 우선이라 이쪽을 택했다. mesh 교체는 별도 과제.\n  근거·재현: 업무목록 T16 · src/drivers/hcr_comm/README.md\n════════════════════════════════════════════════════════════════════════════ -->\n  <joint name="joint_1" type="revolute">\n    <origin rpy="0 0 0" xyz="0.0 0.0 0.03"/>\n    <parent link="base_link"/>\n    <child link="link1_1"/>\n    <axis xyz="0.0 -0.0 1.0"/>\n    <!-- 공식 ±360°, 180°/s (Appendix F·G). 종전 0~360°(음수 불가)는 IK 해가 있어도 계획 실패를 낳았다 -->\n    <limit effort="100" lower="-6.283185" upper="6.283185" velocity="3.141593"/>\n  </joint>\n  <joint name="joint_2" type="revolute">\n    <!-- ★ 실측 교정: x −0.0785→−0.059138 (+19.36mm). joint_3.x 와 짝을 이룬다 (아래 참조) -->\n    <origin rpy="0 0 0" xyz="-0.059138 0.0 0.119001"/>\n    <parent link="link1_1"/>\n    <child link="link2_1"/>\n    <axis xyz="-1.0 0.0 0.0"/>\n    <limit effort="100" lower="-6.283185" upper="6.283185" velocity="3.141593"/>\n  </joint>\n  <joint name="joint_3" type="revolute">\n    <!-- ★ 실측 교정: z 0.424→0.425001 (상완 +1mm) · y 0.001→0 · x 0.000652→−0.019348\n       joint_2.x 와 joint_3.x 는 축이 평행해 겉보기엔 합만 의미 있을 것 같지만, 두 origin\n       사이에 J2 회전이 끼어 있어 실제로는 개별 식별된다. 합만 맞추면 RMS 가 0.28mm 로\n       남고, 최소제곱 해를 그대로 쓰면 0.0038mm 가 된다 -->\n    <origin rpy="0 0 0" xyz="-0.019348 0.0 0.425001"/>\n    <parent link="link2_1"/>\n    <child link="link3_1"/>\n    <axis xyz="1.0 0.0 0.0"/>\n    <!-- J3 만 별도 제한 ±165° 가 실제로 존재한다 -->\n    <limit effort="100" lower="-2.879793" upper="2.879793" velocity="3.141593"/>\n  </joint>\n  <joint name="joint_4" type="revolute">\n    <!-- ★ 실측 교정: z 0.338567→0.338499 (−0.07mm) -->\n    <origin rpy="0 0 0" xyz="-0.030016 -8e-06 0.338499"/>\n    <parent link="link3_1"/>\n    <child link="link4_1"/>\n    <axis xyz="-1.0 0.0 -0.0"/>\n    <limit effort="100" lower="-6.283185" upper="6.283185" velocity="3.141593"/>\n  </joint>\n  <joint name="joint_5" type="revolute">\n    <!-- ★ 실측 교정: z 0.089596→0.089504 (−0.09mm) -->\n    <origin rpy="0 0 0" xyz="-0.062 0.0 0.089504"/>\n    <parent link="link4_1"/>\n    <child link="link5_1"/>\n    <axis xyz="-0.0 -0.0 1.0"/>\n    <!-- 실기 wrist2 가 −267° 로 관측된다 — 종전 ±120° 로는 현재 자세조차 표현 못 했다 -->\n    <limit effort="100" lower="-6.283185" upper="6.283185" velocity="3.141593"/>\n  </joint>\n  <joint name="joint_6" type="revolute">\n    <!-- ★ 실측 교정: x −0.089596→−0.132498 (−42.90mm). J5 축에서 flange 까지 거리가\n       실기 132.5mm 인데 URDF 는 89.6mm 였다. 이 한 건이 전체 오차의 대부분이었다 -->\n    <origin rpy="0 0 0" xyz="-0.132498 0.0 0.062"/>\n    <parent link="link5_1"/>\n    <child link="link6_1"/>\n    <axis xyz="-1.0 -0.0 0.0"/>\n    <limit effort="100" lower="-6.283185" upper="6.283185" velocity="3.141593"/>\n  </joint>\n</robot>\n')

