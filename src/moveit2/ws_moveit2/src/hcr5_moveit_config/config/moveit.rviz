Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Planned Path:
        # true 면 계획된 궤적을 유령 로봇이 무한 반복 재생한다 — 실행이 끝나도
        # 계속 움직이는 것처럼 보여 실제 동작과 헷갈린다. 그래서 껐다.
        # (이건 '계획 미리보기'다. 펜 끝 자취를 선으로 남기는 것은 2단계의 hcr_viz 몫)
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        # Scene Robot = /joint_states 를 따라가는 **실제 로봇**이다.
        # 기본값 0.5(반투명)로 두면, 주황 불투명으로 그려지는 Query Goal State
        # (인터랙티브 마커의 목표 자세 미리보기)가 더 진해 보여서 둘이 뒤바뀌어 읽힌다.
        # 실제로 움직이는 쪽이 가장 선명해야 하므로 1.0 으로 올렸다.
        #
        # 프로그램으로만 구동할 때는 Planning Request → Query Goal State 를 꺼두면
        # 주황색이 아예 사라져 더 깔끔하다 (수동으로 마커를 끌 때는 다시 켤 것).
        Robot Alpha: 1.0
      Value: true
  Global Options:
    Fixed Frame: base_link
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: -0.1
        Y: 0.25
        Z: 0.30
      Name: Current View
      Pitch: 0.5
      Target Frame: base_link
      Yaw: -0.623
Window Geometry:
  Height: 975
  QMainWindow State: 
  Width: 1200
